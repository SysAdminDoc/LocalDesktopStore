<Window x:Class="LocalDesktopStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalDesktopStore.ViewModels"
        xmlns:views="clr-namespace:LocalDesktopStore.Views"
        xmlns:conv="clr-namespace:LocalDesktopStore.Converters"
        Title="LocalDesktopStore" Height="820" Width="1280"
        MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="168" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CrustBrush}"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
             <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="8"
                        Background="{DynamicResource MauveSoftBrush}"
                        BorderBrush="{DynamicResource MauveBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <TextBlock Text="LDS"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MauveBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="LocalDesktopStore" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="A private catalog for Windows desktop apps built from your GitHub releases."
                               Style="{StaticResource SubtleText}" />
                    <TextBlock Style="{StaticResource MuteText}" Margin="0,3,0,0">
                        <Run Text="{Binding AvailableCount, Mode=OneWay}" />
                        <Run Text=" available" />
                        <Run Text=" / " Foreground="{DynamicResource MuteBrush}" />
                        <Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{DynamicResource GreenBrush}" />
                        <Run Text=" installed" />
                    </TextBlock>
                </StackPanel>

                <Menu Grid.Column="2"
                      VerticalAlignment="Top"
                      Margin="16,0,0,0">
                    <MenuItem Header="_File"
                              AutomationProperties.Name="File menu">
                        <MenuItem Header="_Export catalog"
                                  Command="{Binding ExportCatalogCommand}"
                                  AutomationProperties.Name="Export catalog" />
                        <MenuItem Header="_Import catalog"
                                  Command="{Binding ImportCatalogCommand}"
                                  AutomationProperties.Name="Import catalog" />
                    </MenuItem>
                </Menu>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource MantleBrush}"
                Padding="20,12"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,0,0,1">
             <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="470" MinWidth="320">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search apps, repositories, or descriptions" />
                        <TextBlock Text="Search apps, repositories, or descriptions"
                                   Style="{StaticResource MuteText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVis}}" />
                    </Grid>

                    <CheckBox Grid.Column="2"
                              Content="Installed only"
                              IsChecked="{Binding ShowInstalledOnly}"
                              AutomationProperties.Name="Show installed apps only"
                              VerticalAlignment="Center"
                              Margin="18,0" />

                    <Button Grid.Column="4"
                            Content="Install folder"
                            Command="{Binding OpenInstallDirCommand}"
                            AutomationProperties.Name="Open install folder"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="5"
                            Content="{Binding UpdateAllButtonLabel}"
                            Command="{Binding UpdateAllCommand}"
                            AutomationProperties.Name="Update all outdated apps"
                            ToolTip="Sequentially update every installed app whose remote release is newer than the local pin."
                            Visibility="{Binding HasOutdated, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="6"
                            Content="{Binding RefreshButtonLabel}"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Refresh catalog"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="7"
                            Content="Settings"
                            x:Name="SettingsToggleButton"
                            AutomationProperties.Name="Show or hide settings"
                            Click="ToggleSettings_Click" />
                </Grid>

                <ProgressBar Grid.Row="1"
                             IsIndeterminate="True"
                             Margin="0,10,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

                <Border Grid.Row="2"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionSummary}"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button Content="Install selected"
                                Command="{Binding InstallSelectedCommand}"
                                Style="{StaticResource AccentButton}"
                                AutomationProperties.Name="Install selected apps"
                                Margin="0,0,8,0" />
                        <Button Content="Update selected"
                                Command="{Binding UpdateSelectedCommand}"
                                AutomationProperties.Name="Update selected apps"
                                Margin="0,0,8,0" />
                        <Button Content="Uninstall selected"
                                Command="{Binding UninstallSelectedCommand}"
                                Style="{StaticResource DangerButton}"
                                AutomationProperties.Name="Uninstall selected apps"
                                Margin="0,0,8,0" />
                        <Button Content="Clear selection"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource LinkButton}"
                                AutomationProperties.Name="Clear selected apps" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SettingsDrawer"
                Grid.Row="2"
                Style="{StaticResource PanelBorder}"
                Margin="20,14,20,0"
                Padding="18"
                Visibility="Collapsed"
                Effect="{StaticResource PanelShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="560">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Discovery settings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Configure the curated GitHub source, optional search discovery, hash verification, and rate-limit token."
                                   Style="{StaticResource SubtleText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Close"
                            Click="ToggleSettings_Click"
                            AutomationProperties.Name="Close settings"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Top" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="GitHub user or organization" Style="{StaticResource InputLabel}" />
                        <Grid>
                            <TextBox x:Name="GitHubUserBox"
                                     Text="{Binding GitHubUserInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="GitHub user or organization" />
                            <TextBlock Text="example: SysAdminDoc"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=GitHubUserBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>

                        <TextBlock Text="GitHub personal access token"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <PasswordBox x:Name="GitHubTokenBox"
                                     AutomationProperties.Name="GitHub personal access token"
                                     PasswordChanged="GitHubTokenBox_PasswordChanged" />
                        <TextBlock Text="Optional. Stored only in your local settings file; leave blank to use public GitHub rate limits."
                                   Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />

                        <TextBlock Text="Install folder override"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <Grid>
                            <TextBox x:Name="InstallRootBox"
                                     Text="{Binding InstallRootOverride, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Install folder override" />
                            <TextBlock Text="(default %LOCALAPPDATA%\LocalDesktopStore\apps)"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=InstallRootBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>

                        <TextBlock Text="Extra GitHub owners"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="ExtraOwnerBox"
                                         Text="{Binding ExtraOwnerInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Extra GitHub owner" />
                                <TextBlock Text="owner or organization"
                                           Style="{StaticResource MuteText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=ExtraOwnerBox, Converter={StaticResource EmptyStringToVis}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddExtraOwnerCommand}"
                                    AutomationProperties.Name="Add extra GitHub owner"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="No extra owners configured."
                                   Style="{StaticResource MuteText}"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding HasExtraOwners, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ListBox ItemsSource="{Binding ExtraOwners}"
                                 AutomationProperties.Name="Extra GitHub owners"
                                 MaxHeight="82"
                                 Margin="0,7,0,0"
                                 Visibility="{Binding HasExtraOwners, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveExtraOwnerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Remove extra GitHub owner"
                                                Style="{StaticResource LinkButton}"
                                                Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource SubtleText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Appearance" Style="{StaticResource InputLabel}" />
                        <CheckBox Content="Use Catppuccin Latte light theme"
                                  IsChecked="{Binding UseLightTheme}"
                                  AutomationProperties.Name="Use Catppuccin Latte light theme" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                   Text="Switches the palette immediately; save settings to keep it for the next launch." />
                        <CheckBox Content="Use Windows system accent"
                                  IsChecked="{Binding UseSystemAccent}"
                                  AutomationProperties.Name="Use Windows system accent color"
                                  Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                   Text="Uses the Windows accent for the primary action and focus ring." />

                        <TextBlock Text="Background updates"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <CheckBox Content="Check for updates in the background"
                                  IsChecked="{Binding EnableScheduledUpdateChecks}"
                                  AutomationProperties.Name="Check for updates in the background" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Interval (hours)"
                                       Style="{StaticResource MuteText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ScheduledUpdateIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Background update interval in hours"
                                     IsEnabled="{Binding EnableScheduledUpdateChecks}"
                                     Padding="8,5"
                                     MinHeight="30" />
                            <TextBlock Grid.Column="2"
                                       Text="1–24; runs as the signed-in user and never installs automatically."
                                       Style="{StaticResource MuteText}"
                                       TextWrapping="Wrap"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="Filter by GitHub topic"
                                  IsChecked="{Binding UseTopicFilter}"
                                  AutomationProperties.Name="Filter discovery by GitHub topic" />
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="TopicFilterBox"
                                     Text="{Binding TopicFilter, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="GitHub topic filter"
                                     IsEnabled="{Binding UseTopicFilter}" />
                            <TextBlock Text="windows-app"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=TopicFilterBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="When enabled, discovery only shows repos tagged with the selected topic. Otherwise any repo whose latest release ships an MSI / EXE / ZIP can appear." />

                        <CheckBox Content="Opt in to GitHub Search discovery"
                                  IsChecked="{Binding EnableGitHubSearchDiscovery}"
                                  AutomationProperties.Name="Opt in to GitHub Search discovery"
                                  Margin="0,16,0,0" />
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="SearchTopicBox"
                                     Text="{Binding SearchTopic, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="GitHub Search topic"
                                     IsEnabled="{Binding EnableGitHubSearchDiscovery}" />
                            <TextBlock Text="windows-app"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchTopicBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="Search results are uncurated. Every search-discovered install requires an explicit Authenticode thumbprint pin below." />

                        <CheckBox Content="Verify SHA-256 sidecar"
                                  IsChecked="{Binding VerifyHashSidecar}"
                                  AutomationProperties.Name="Verify SHA-256 sidecar before installation"
                                  Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="When enabled, every install verifies the asset against its `.sha256.txt` sidecar before invoking the installer. Refuses to install on mismatch." />

                        <TextBlock Text="Search-discovery publisher pins"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <TextBox Text="{Binding SearchPublisherPinsInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search discovery publisher pins"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="54"
                                 MaxHeight="78"
                                 ToolTip="One per line: owner/repo=40-character Authenticode SHA-1 thumbprint." />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                   Text="Pins are required only for GitHub Search results. Use the signer thumbprint shown by a trusted release or your existing installed manifest." />

                        <TextBlock Text="Hidden repositories"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="HiddenRepoBox"
                                         Text="{Binding HiddenRepoInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Repository to hide" />
                                <TextBlock Text="owner/repo"
                                           Style="{StaticResource MuteText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=HiddenRepoBox, Converter={StaticResource EmptyStringToVis}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddHiddenRepoCommand}"
                                    AutomationProperties.Name="Add hidden repository"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="Hidden repos stay out of discovery and the current catalog view."
                                   Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="No hidden repos configured."
                                   Style="{StaticResource MuteText}"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding HasHiddenRepos, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ListBox ItemsSource="{Binding HiddenRepos}"
                                 AutomationProperties.Name="Hidden repositories"
                                 MaxHeight="82"
                                 Margin="0,7,0,0"
                                 Visibility="{Binding HasHiddenRepos, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="Unhide"
                                                Command="{Binding DataContext.RemoveHiddenRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Unhide hidden repository"
                                                Style="{StaticResource LinkButton}"
                                                Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource SubtleText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                MinWidth="170"
                                VerticalAlignment="Bottom">
                        <Button Content="Save and refresh"
                                Command="{Binding SaveAndRefreshCommand}"
                                AutomationProperties.Name="Save settings and refresh catalog"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,0,8" />
                        <Button Content="Save settings"
                                Command="{Binding SaveSettingsCommand}"
                                AutomationProperties.Name="Save settings" />
                    </StackPanel>
                </Grid>
             </Grid>
             </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,14,12,16">
                <ItemsControl ItemsSource="{Binding AppsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AppCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Padding="24"
                    Style="{StaticResource PanelBorder}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               Style="{StaticResource SectionTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Style="{StaticResource SubtleText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Refresh catalog"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="Refresh catalog"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Open settings"
                                Click="ToggleSettings_Click"
                                AutomationProperties.Name="Open settings" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource MantleBrush}"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,8,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Activity log" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Download, install, run, and error events"
                               Style="{StaticResource MuteText}"
                               Margin="10,1,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Clear"
                        Command="{Binding ClearLogCommand}"
                        AutomationProperties.Name="Clear activity log"
                        Style="{StaticResource LinkButton}"
                        Margin="0,0,16,0" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{DynamicResource CrustBrush}" Padding="16,10">
            <ListBox ItemsSource="{Binding LogLines}"
                     AutomationProperties.Name="Activity log"
                     AutomationProperties.LiveSetting="Polite"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="11"
                     Foreground="{DynamicResource SubtextBrush}"
                     x:Name="LogList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0,1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Border Grid.Row="6"
                Background="{DynamicResource CrustBrush}"
                Padding="16,7"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource SubtleText}" />
                <TextBlock Grid.Column="1" Style="{StaticResource MuteText}">
                    <Run Text="LocalDesktopStore v0.2.1" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
