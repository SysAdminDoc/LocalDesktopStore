<Window x:Class="LocalDesktopStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LocalDesktopStore.Localization"
        xmlns:vm="clr-namespace:LocalDesktopStore.ViewModels"
        xmlns:views="clr-namespace:LocalDesktopStore.Views"
        xmlns:conv="clr-namespace:LocalDesktopStore.Converters"
        Title="{loc:Loc Key=MainWindow_Title}" Height="820" Width="1280"
        MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis" />
    </Window.Resources>

    <Grid Background="{DynamicResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="168" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CrustBrush}"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
             <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="8"
                        Background="{DynamicResource MauveSoftBrush}"
                        BorderBrush="{DynamicResource MauveBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <TextBlock Text="{loc:Loc Key=MainWindow_Badge}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MauveBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=MainWindow_Title}" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{loc:Loc Key=MainWindow_Tagline}"
                               Style="{StaticResource SubtleText}" />
                    <TextBlock Style="{StaticResource MuteText}" Margin="0,3,0,0">
                        <Run Text="{Binding AvailableCount, Mode=OneWay}" />
                        <Run Text="{loc:Loc Key=MainWindow_AvailableSuffix}" />
                        <Run Text="{loc:Loc Key=MainWindow_Separator}" Foreground="{DynamicResource MuteBrush}" />
                        <Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{DynamicResource GreenBrush}" />
                        <Run Text="{loc:Loc Key=MainWindow_InstalledSuffix}" />
                    </TextBlock>
                </StackPanel>

                <Menu Grid.Column="2"
                      VerticalAlignment="Top"
                      Margin="16,0,0,0">
                    <MenuItem Header="{loc:Loc Key=MainWindow_FileMenu}"
                              AutomationProperties.Name="{loc:Loc Key=MainWindow_FileMenuAutomation}">
                        <MenuItem Header="{loc:Loc Key=MainWindow_ExportCatalog}"
                                  Command="{Binding ExportCatalogCommand}"
                                  AutomationProperties.Name="{loc:Loc Key=MainWindow_ExportCatalogAutomation}" />
                        <MenuItem Header="{loc:Loc Key=MainWindow_ImportCatalog}"
                                  Command="{Binding ImportCatalogCommand}"
                                  AutomationProperties.Name="{loc:Loc Key=MainWindow_ImportCatalogAutomation}" />
                        <MenuItem Header="{loc:Loc Key=MainWindow_CheckForUpdates}"
                                  Command="{Binding CheckForUpdatesCommand}"
                                  AutomationProperties.Name="{loc:Loc Key=MainWindow_CheckForUpdatesAutomation}"
                                  ToolTip="{loc:Loc Key=MainWindow_CheckForUpdatesTooltip}" />
                    </MenuItem>
                </Menu>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource MantleBrush}"
                Padding="20,12"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,0,0,1">
             <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="470" MinWidth="320">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Loc Key=MainWindow_SearchAutomation}" />
                        <TextBlock Text="{loc:Loc Key=MainWindow_SearchAutomation}"
                                   Style="{StaticResource MuteText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVis}}" />
                    </Grid>

                    <CheckBox Grid.Column="2"
                              Content="{loc:Loc Key=MainWindow_InstalledOnly}"
                              IsChecked="{Binding ShowInstalledOnly}"
                              AutomationProperties.Name="{loc:Loc Key=MainWindow_InstalledOnlyAutomation}"
                              VerticalAlignment="Center"
                              Margin="18,0" />

                    <Button Grid.Column="4"
                            Content="{loc:Loc Key=MainWindow_InstallFolder}"
                            Command="{Binding OpenInstallDirCommand}"
                            AutomationProperties.Name="{loc:Loc Key=MainWindow_InstallFolderAutomation}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="5"
                            Content="{Binding UpdateAllButtonLabel}"
                            Command="{Binding UpdateAllCommand}"
                            AutomationProperties.Name="{loc:Loc Key=MainWindow_UpdateAllAutomation}"
                            ToolTip="{loc:Loc Key=MainWindow_UpdateAllTooltip}"
                            Visibility="{Binding HasOutdated, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="6"
                            Content="{Binding RefreshButtonLabel}"
                            Command="{Binding RefreshCommand}"
                             AutomationProperties.Name="{loc:Loc Key=MainWindow_RefreshAutomation}"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="7"
                            Content="{loc:Loc Key=MainWindow_Settings}"
                            x:Name="SettingsToggleButton"
                            AutomationProperties.Name="{loc:Loc Key=MainWindow_SettingsAutomation}"
                            Click="ToggleSettings_Click" />
                </Grid>

                <ProgressBar Grid.Row="1"
                             IsIndeterminate="True"
                             Margin="0,10,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

                <Border Grid.Row="2"
                        Style="{StaticResource PanelBorder}"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectionSummary}"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <Button Content="{loc:Loc Key=MainWindow_InstallSelected}"
                                Command="{Binding InstallSelectedCommand}"
                                Style="{StaticResource AccentButton}"
                                AutomationProperties.Name="{loc:Loc Key=MainWindow_InstallSelectedAutomation}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Key=MainWindow_UpdateSelected}"
                                Command="{Binding UpdateSelectedCommand}"
                                AutomationProperties.Name="{loc:Loc Key=MainWindow_UpdateSelectedAutomation}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Key=MainWindow_UninstallSelected}"
                                Command="{Binding UninstallSelectedCommand}"
                                Style="{StaticResource DangerButton}"
                                AutomationProperties.Name="{loc:Loc Key=MainWindow_UninstallSelectedAutomation}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Key=MainWindow_ClearSelection}"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource LinkButton}"
                                AutomationProperties.Name="{loc:Loc Key=MainWindow_ClearSelectionAutomation}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SettingsDrawer"
                Grid.Row="2"
                Style="{StaticResource PanelBorder}"
                Margin="20,14,20,0"
                Padding="18"
                Visibility="Collapsed"
                Effect="{StaticResource PanelShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="560">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Key=Settings_Title}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{loc:Loc Key=Settings_Description}"
                                   Style="{StaticResource SubtleText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{loc:Loc Key=Settings_Close}"
                            Click="ToggleSettings_Click"
                            AutomationProperties.Name="{loc:Loc Key=Settings_CloseAutomation}"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Top" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc Key=Settings_GitHubUserLabel}" Style="{StaticResource InputLabel}" />
                        <Grid>
                            <TextBox x:Name="GitHubUserBox"
                                     Text="{Binding GitHubUserInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Loc Key=Settings_GitHubUserLabel}" />
                            <TextBlock Text="{loc:Loc Key=Settings_GitHubUserPlaceholder}"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=GitHubUserBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>

                        <TextBlock Text="{loc:Loc Key=Settings_GitHubTokenLabel}"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <PasswordBox x:Name="GitHubTokenBox"
                                     AutomationProperties.Name="{loc:Loc Key=Settings_GitHubTokenAutomation}"
                                     PasswordChanged="GitHubTokenBox_PasswordChanged" />
                        <TextBlock Text="{loc:Loc Key=Settings_GitHubTokenHelp}"
                                   Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />

                        <TextBlock Text="{loc:Loc Key=Settings_InstallFolderLabel}"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <Grid>
                            <TextBox x:Name="InstallRootBox"
                                     Text="{Binding InstallRootOverride, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Loc Key=Settings_InstallFolderAutomation}" />
                            <TextBlock Text="{loc:Loc Key=Settings_InstallFolderPlaceholder}"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=InstallRootBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>

                        <TextBlock Text="{loc:Loc Key=Settings_ExtraOwnersLabel}"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="ExtraOwnerBox"
                                         Text="{Binding ExtraOwnerInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=Settings_ExtraOwnerAutomation}" />
                                <TextBlock Text="{loc:Loc Key=Settings_ExtraOwnerPlaceholder}"
                                           Style="{StaticResource MuteText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=ExtraOwnerBox, Converter={StaticResource EmptyStringToVis}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="{loc:Loc Key=Common_Add}"
                                    Command="{Binding AddExtraOwnerCommand}"
                                    AutomationProperties.Name="{loc:Loc Key=Settings_AddExtraOwnerAutomation}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Key=Settings_NoExtraOwners}"
                                   Style="{StaticResource MuteText}"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding HasExtraOwners, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ListBox ItemsSource="{Binding ExtraOwners}"
                                 AutomationProperties.Name="{loc:Loc Key=Settings_ExtraOwnersAutomation}"
                                 MaxHeight="82"
                                 Margin="0,7,0,0"
                                 Visibility="{Binding HasExtraOwners, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="{loc:Loc Key=Common_Remove}"
                                                Command="{Binding DataContext.RemoveExtraOwnerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{loc:Loc Key=Settings_RemoveExtraOwnerAutomation}"
                                                Style="{StaticResource LinkButton}"
                                                Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource SubtleText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Loc Key=Settings_Appearance}" Style="{StaticResource InputLabel}" />
                        <CheckBox Content="{loc:Loc Key=Settings_LightTheme}"
                                  IsChecked="{Binding UseLightTheme}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_LightThemeAutomation}" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                    Text="{loc:Loc Key=Settings_LightThemeHelp}" />
                        <CheckBox Content="{loc:Loc Key=Settings_SystemAccent}"
                                  IsChecked="{Binding UseSystemAccent}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_SystemAccentAutomation}"
                                  Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                    Text="{loc:Loc Key=Settings_SystemAccentHelp}" />
                        <TextBlock Text="{loc:Loc Key=Settings_LanguageLabel}"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <ComboBox ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding UiLanguage, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_LanguageAutomation}" />

                        <TextBlock Text="{loc:Loc Key=Settings_BackgroundUpdates}"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <CheckBox Content="{loc:Loc Key=Settings_CheckBackground}"
                                  IsChecked="{Binding EnableScheduledUpdateChecks}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_CheckBackgroundAutomation}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Loc Key=Settings_IntervalHours}"
                                       Style="{StaticResource MuteText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ScheduledUpdateIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{loc:Loc Key=Settings_IntervalAutomation}"
                                     IsEnabled="{Binding EnableScheduledUpdateChecks}"
                                     Padding="8,5"
                                     MinHeight="30" />
                            <TextBlock Grid.Column="2"
                                       Text="{loc:Loc Key=Settings_BackgroundHelp}"
                                       Style="{StaticResource MuteText}"
                                       TextWrapping="Wrap"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="{loc:Loc Key=Settings_FilterTopic}"
                                  IsChecked="{Binding UseTopicFilter}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_FilterTopicAutomation}" />
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="TopicFilterBox"
                                     Text="{Binding TopicFilter, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{loc:Loc Key=Settings_TopicAutomation}"
                                     IsEnabled="{Binding UseTopicFilter}" />
                            <TextBlock Text="{loc:Loc Key=Settings_TopicPlaceholder}"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=TopicFilterBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                    Text="{loc:Loc Key=Settings_TopicHelp}" />

                        <CheckBox Content="{loc:Loc Key=Settings_SearchDiscovery}"
                                  IsChecked="{Binding EnableGitHubSearchDiscovery}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_SearchDiscoveryAutomation}"
                                  Margin="0,16,0,0" />
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="SearchTopicBox"
                                     Text="{Binding SearchTopic, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{loc:Loc Key=Settings_SearchTopicAutomation}"
                                     IsEnabled="{Binding EnableGitHubSearchDiscovery}" />
                            <TextBlock Text="{loc:Loc Key=Settings_TopicPlaceholder}"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchTopicBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                    Text="{loc:Loc Key=Settings_SearchDiscoveryHelp}" />

                        <CheckBox Content="{loc:Loc Key=Settings_VerifySidecar}"
                                  IsChecked="{Binding VerifyHashSidecar}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_VerifySidecarAutomation}"
                                  Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                    Text="{loc:Loc Key=Settings_VerifyHelp}" />

                        <CheckBox Content="{loc:Loc Key=Settings_AdvisoryChecks}"
                                  IsChecked="{Binding EnableAdvisoryChecks}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_AdvisoryChecksAutomation}"
                                  Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="{loc:Loc Key=Settings_AdvisoryChecksHelp}" />

                        <TextBlock Text="{loc:Loc Key=Settings_SearchPinsLabel}"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <TextBox Text="{Binding SearchPublisherPinsInput, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="{loc:Loc Key=Settings_SearchPinsAutomation}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="54"
                                 MaxHeight="78"
                                  ToolTip="{loc:Loc Key=Settings_SearchPinsTooltip}" />
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                    Text="{loc:Loc Key=Settings_SearchPinsHelp}" />

                        <TextBlock Text="{loc:Loc Key=Settings_HiddenReposLabel}"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="HiddenRepoBox"
                                         Text="{Binding HiddenRepoInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=Settings_HiddenRepoAutomation}" />
                                <TextBlock Text="{loc:Loc Key=Settings_HiddenRepoPlaceholder}"
                                           Style="{StaticResource MuteText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=HiddenRepoBox, Converter={StaticResource EmptyStringToVis}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="{loc:Loc Key=Common_Add}"
                                    Command="{Binding AddHiddenRepoCommand}"
                                    AutomationProperties.Name="{loc:Loc Key=Settings_AddHiddenAutomation}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Key=Settings_HiddenHelp}"
                                   Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="{loc:Loc Key=Settings_NoHidden}"
                                   Style="{StaticResource MuteText}"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding HasHiddenRepos, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ListBox ItemsSource="{Binding HiddenRepos}"
                                 AutomationProperties.Name="{loc:Loc Key=Settings_HiddenReposAutomation}"
                                 MaxHeight="82"
                                 Margin="0,7,0,0"
                                 Visibility="{Binding HasHiddenRepos, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Content="{loc:Loc Key=Common_Unhide}"
                                                Command="{Binding DataContext.RemoveHiddenRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{loc:Loc Key=Settings_UnhideAutomation}"
                                                Style="{StaticResource LinkButton}"
                                                Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource SubtleText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                MinWidth="170"
                                VerticalAlignment="Bottom">
                        <Button Content="{loc:Loc Key=Settings_SaveRefresh}"
                                Command="{Binding SaveAndRefreshCommand}"
                                 AutomationProperties.Name="{loc:Loc Key=Settings_SaveRefreshAutomation}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,0,8" />
                        <Button Content="{loc:Loc Key=Settings_Save}"
                                Command="{Binding SaveSettingsCommand}"
                                 AutomationProperties.Name="{loc:Loc Key=Settings_SaveAutomation}" />
                    </StackPanel>
                </Grid>
             </Grid>
             </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,14,12,16">
                <ItemsControl ItemsSource="{Binding AppsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AppCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Padding="24"
                    Style="{StaticResource PanelBorder}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               Style="{StaticResource SectionTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Style="{StaticResource SubtleText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{loc:Loc Key=Empty_Refresh}"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="{loc:Loc Key=Empty_RefreshAutomation}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Key=Empty_OpenSettings}"
                                Click="ToggleSettings_Click"
                                AutomationProperties.Name="{loc:Loc Key=Empty_OpenSettingsAutomation}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource MantleBrush}"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,8,0,8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=Activity_Title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{loc:Loc Key=Activity_Description}"
                               Style="{StaticResource MuteText}"
                               Margin="10,1,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{loc:Loc Key=Common_Clear}"
                        Command="{Binding ClearLogCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Activity_ClearAutomation}"
                        Style="{StaticResource LinkButton}"
                        Margin="0,0,16,0" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{DynamicResource CrustBrush}" Padding="16,10">
            <ListBox ItemsSource="{Binding LogLines}"
                     AutomationProperties.Name="{loc:Loc Key=Activity_Automation}"
                     AutomationProperties.LiveSetting="Polite"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="11"
                     Foreground="{DynamicResource SubtextBrush}"
                     x:Name="LogList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0,1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Border Grid.Row="6"
                Background="{DynamicResource CrustBrush}"
                Padding="16,7"
                BorderBrush="{DynamicResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource SubtleText}" />
                <TextBlock Grid.Column="1" Style="{StaticResource MuteText}">
                    <Run Text="{loc:Loc Key=Footer_Version}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
