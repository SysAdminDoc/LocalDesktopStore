<UserControl x:Class="LocalDesktopStore.Views.AppCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LocalDesktopStore.Converters"
             xmlns:loc="clr-namespace:LocalDesktopStore.Localization"
             xmlns:vm="clr-namespace:LocalDesktopStore.ViewModels"
             d:DataContext="{d:DesignInstance vm:AppCardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="378" Height="400">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="52"
                        Height="52"
                        CornerRadius="8"
                        Background="{DynamicResource Surface0Brush}"
                        BorderBrush="{DynamicResource Surface1Brush}"
                        BorderThickness="1"
                        Margin="0,0,12,0">
                    <Grid>
                        <Image Source="{Binding Icon}"
                               Stretch="Uniform"
                               Margin="7"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{loc:Loc Key=Card_Badge}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MauveBrush}"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Repo}"
                               Style="{StaticResource MuteText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <TextBlock Text="{Binding Stars}"
                               Style="{StaticResource BadgeText}"
                               Foreground="{DynamicResource YellowBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:Loc Key=Card_Export}"
                            Command="{Binding ExportWingetCommand}"
                            Style="{StaticResource LinkButton}"
                            AutomationProperties.Name="{loc:Loc Key=Card_ExportAutomation}"
                            ToolTip="{loc:Loc Key=Card_ExportTooltip}"
                            Margin="8,-4,0,0" />
                    <Button Content="{loc:Loc Key=Card_Hide}"
                            Command="{Binding HideCommand}"
                            Style="{StaticResource LinkButton}"
                            AutomationProperties.Name="{loc:Loc Key=Card_HideAutomation}"
                            ToolTip="{loc:Loc Key=Card_HideTooltip}"
                            Margin="8,-4,0,0" />
                </StackPanel>

                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          AutomationProperties.Name="{loc:Loc Key=Card_SelectAutomation}"
                          ToolTip="{loc:Loc Key=Card_SelectTooltip}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="-6,-6,0,0"
                          Panel.ZIndex="2" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="8"
                        Padding="9,4"
                        Margin="0,0,8,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SapphireSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SapphireBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GreenSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource YellowSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAsset}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource RedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusBadge}" Style="{StaticResource BadgeText}" />
                </Border>

                <Border Grid.Column="1"
                        CornerRadius="8"
                        Padding="9,4"
                        Margin="0,0,8,0"
                        Background="{DynamicResource MauveSoftBrush}"
                        BorderBrush="{DynamicResource MauveBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding KindLabel}"
                               Style="{StaticResource BadgeText}"
                               Foreground="{DynamicResource MauveBrush}" />
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InstalledDetail}"
                               Style="{StaticResource MuteText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MuteText}"
                               ToolTip="{loc:Loc Key=Card_AdvisoriesTooltip}"
                               Visibility="{Binding HasAdvisoryResult, Converter={StaticResource BoolToVis}}">
                        <Run Text="{loc:Loc Key=Card_AdvisoriesPrefix}" />
                        <Run Text="{Binding AdvisoryCount}" />
                    </TextBlock>
                    <TextBlock Text="{loc:Loc Key=Card_AdvisoriesUnavailable}"
                               Foreground="{DynamicResource YellowBrush}"
                               Style="{StaticResource MuteText}"
                               ToolTip="{loc:Loc Key=Card_AdvisoriesTooltip}"
                               Visibility="{Binding AdvisoryCheckUnavailable, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2"
                       Text="{Binding Description}"
                       Style="{StaticResource SubtleText}"
                       TextWrapping="Wrap"
                       MaxHeight="58"
                       TextTrimming="CharacterEllipsis" />

            <Grid Grid.Row="3" Margin="0,12,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding AssetSummary}"
                           Style="{StaticResource MuteText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding ReleaseSummary}"
                           Style="{StaticResource MuteText}"
                           Margin="10,0,0,0" />
                <ProgressBar Grid.Row="1"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             IsIndeterminate="True"
                             Margin="0,8,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Grid.Row="4"
                       Text="{Binding BusyMessage}"
                       Foreground="{DynamicResource SapphireBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"
                       Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="5"
                  Margin="0,0,0,8"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource RedBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Content="{loc:Loc Key=Card_ViewCrash}"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenCrashLogCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Card_ViewCrashAutomation}"
                        ToolTip="{loc:Loc Key=Card_ViewCrashTooltip}" />
            </Grid>

            <Grid Grid.Row="6"
                  Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc Key=Card_CustomArgsLabel}"
                           Style="{StaticResource MuteText}"
                           AutomationProperties.Name="{loc:Loc Key=Card_CustomArgsLabelAutomation}" />
                <TextBox Grid.Row="1"
                         Text="{Binding CustomInstallerArguments, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding CanCustomizeInstallerArguments}"
                         MaxLength="4096"
                         AutomationProperties.Name="{loc:Loc Key=Card_CustomArgsAutomation}"
                         ToolTip="{loc:Loc Key=Card_CustomArgsTooltip}"
                         Margin="0,4,0,0" />
            </Grid>

            <StackPanel Grid.Row="7"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <CheckBox Content="{loc:Loc Key=Card_RunAfter}"
                          IsChecked="{Binding RunAfterInstall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{loc:Loc Key=Card_RunAfterAutomation}"
                          ToolTip="{loc:Loc Key=Card_RunAfterTooltip}" />
                <CheckBox Content="{loc:Loc Key=Card_PinAfter}"
                          IsChecked="{Binding PinToTaskbar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{loc:Loc Key=Card_PinAfterAutomation}"
                          ToolTip="{loc:Loc Key=Card_PinAfterTooltip}"
                          Margin="16,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="{Binding InstallButtonLabel}"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding InstallCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Card_InstallAutomation}"
                        IsEnabled="{Binding CanInstall}"
                        MinWidth="96"
                        Margin="0,0,6,0" />
                <Button Grid.Column="2"
                        Content="{loc:Loc Key=Card_Run}"
                        Style="{StaticResource SuccessButton}"
                        Command="{Binding RunCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Card_RunAutomation}"
                        IsEnabled="{Binding CanRun}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,6,0" />
                <Button Grid.Column="3"
                        Content="{loc:Loc Key=Card_Uninstall}"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding UninstallCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Card_UninstallAutomation}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,6,0" />
                <Button Grid.Column="4"
                        Content="{loc:Loc Key=Card_Folder}"
                        Command="{Binding OpenInstallDirCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Card_FolderAutomation}"
                        IsEnabled="{Binding CanOpenDir}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,6,0" />
                <Button Grid.Column="5"
                        Content="{loc:Loc Key=Card_Repo}"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenRepoCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Card_RepoAutomation}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
